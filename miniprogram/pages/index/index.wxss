.container {
  padding: 24rpx;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 8rpx 0 24rpx;
}

.header-info {
  flex: 1;
  min-width: 0;
}

.header-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1f2329;
}

.header-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #8a9099;
}

/* ── 设备在线状态 ── */
.status {
  display: flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.status-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.status.on {
  background: #e6f7ee;
  color: #16a34a;
}

.status.on .status-dot {
  background: #16a34a;
}

.status.off {
  background: #fdeaea;
  color: #dc2626;
}

.status.off .status-dot {
  background: #dc2626;
}

.status.check {
  background: #f0f1f3;
  color: #8a9099;
}

.status.check .status-dot {
  background: #b0b6bf;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

/* ── 顶部舒适度卡片 ── */
.comfort-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.comfort-left {
  display: flex;
  align-items: center;
}

.comfort-emoji {
  font-size: 64rpx;
  line-height: 1;
  margin-right: 20rpx;
}

.comfort-label {
  font-size: 34rpx;
  font-weight: 600;
}

.comfort-tip {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8a9099;
}

.comfort-right {
  text-align: right;
}

.comfort-temp {
  font-size: 44rpx;
  font-weight: 600;
  color: #1f2329;
}

.comfort-hum {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8a9099;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
  margin-bottom: 20rpx;
}

.grid {
  display: flex;
  text-align: center;
}

.grid-item {
  flex: 1;
}

.value {
  font-size: 52rpx;
  font-weight: 600;
  color: #1f2329;
}

.value.pm {
  color: #1aad19;
}

.aqi-badge {
  display: inline-block;
  margin-left: 8rpx;
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  line-height: 1.6;
  border-radius: 20rpx;
  vertical-align: middle;
}

.range-bar {
  display: flex;
  margin-bottom: 16rpx;
}

.range-btn {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #8a9099;
  padding: 10rpx 0;
  margin-right: 12rpx;
  border-radius: 12rpx;
  background: #f5f6f8;
}

.range-btn:last-child {
  margin-right: 0;
}

.range-btn.active {
  color: #fff;
  background: #1aad19;
}

.chart {
  width: 100%;
  height: 360rpx;
}

.unit {
  font-size: 24rpx;
  font-weight: 400;
  color: #8a9099;
  margin-left: 4rpx;
}

.label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8a9099;
}

.hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #8a9099;
  text-align: center;
}

.hint.err {
  color: #e64340;
}

.ctrl-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f1f3;
}

.ctrl-row:last-of-type {
  border-bottom: none;
}

.ctrl-label {
  font-size: 30rpx;
  color: #1f2329;
}

.ctrl-desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #b0b6bf;
}

.slider {
  margin-top: 16rpx;
}

.footer {
  text-align: center;
  font-size: 22rpx;
  color: #b0b6bf;
  margin-top: 12rpx;
}
